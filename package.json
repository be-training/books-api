{
  "name": "books-api",
  "version": "1.0.0",
  "description": "Library Admin Books API built with Fastify, TypeScript, and MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:init": "tsx scripts/init-db.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "mysql",
    "books-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
